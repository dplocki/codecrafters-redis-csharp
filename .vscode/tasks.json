{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/codecrafters-redis.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/codecrafters-redis.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/codecrafters-redis.csproj"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build client",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"/home/idaho/Projekty/codecrafters-redis-csharp/tools/ping_command.csproj"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
	]
}